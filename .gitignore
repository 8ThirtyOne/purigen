public_html/sphider/admin/log/
public_html/sphider/admin/sitemaps/
public_html/sphider/admin/thumbs/
public_html/sphider/admin/urls/
public_html/sphider/include/tmp/
public_html/sphider/include/IDS/tmp/
public_html/sphider/include/textcache/
public_html/sphider/include/mediacache/
public_html/sphider/include/thumbs/
public_html/sphider/xml/

# ---------------------------------------------------------------
# Logs (may contain paths, queries, user input, emails)
# ---------------------------------------------------------------
*.log
error_log
php_errorlog

# ---------------------------------------------------------------
# Database dumps & test data
# ---------------------------------------------------------------
*.sql.gz
*.dump
*.sqlite
*.sqlite3
public_html/test_data

